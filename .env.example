# Copy to .env and adjust. Used by docker-compose.

# Absolute path to your photo/video library on the host. Mounted read-only.
MNEME_LIBRARY=/home/you/Pictures

# Host port the Mneme web UI is served on.
# 6363 = "MEME" on a phone keypad — a nod to μνήμη (mneme), Greek for "memory".
MNEME_PORT=6363
